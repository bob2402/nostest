{
  "name": "nostest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-approving NIP-07 browser extension for disposable Nostr test accounts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "nostr-tools": "2.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.1.37",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
